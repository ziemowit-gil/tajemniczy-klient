{
  "name": "tajemniczy-klient",
  "version": "1.0.0",
  "description": "Audyty dostępności uczelni w ramach akcji „Tajemniczy Klient” (OZN + proces kształcenia)",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test \"test/**/*.test.js\"",
    "demo:seed": "node --env-file-if-exists=.env scripts/demo.js",
    "demo": "npm run demo:seed && npm start"
  },
  "type": "commonjs",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dejavu-fonts-ttf": "^2.37.3",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
