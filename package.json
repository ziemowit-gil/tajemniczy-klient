{
  "name": "tajemniczy-klient",
  "version": "1.3.0",
  "description": "Audyty dost\u0119pno\u015bci uczelni w ramach akcji \u201eTajemniczy Klient\u201d (OZN + proces kszta\u0142cenia)",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test \"test/**/*.test.js\"",
    "demo:seed": "node --env-file-if-exists=.env scripts/demo.js",
    "demo": "npm run demo:seed && npm start",
    "notify": "node --env-file-if-exists=.env scripts/notify.js",
    "scenarios:import": "node --env-file-if-exists=.env scripts/import-scenarios.js"
  },
  "type": "commonjs",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dejavu-fonts-ttf": "^2.37.3",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
