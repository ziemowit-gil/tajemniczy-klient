# Produkcja: audytor.feer.org.pl (MyDevil). Skopiuj na serwer jako .env (chmod 600) i uzupełnij.
NODE_ENV=production
PORT=3000
APP_URL=https://audytor.feer.org.pl
TRUST_PROXY=true

# Dane poza katalogiem aplikacji (przetrwają wdrożenia)
DATABASE_PATH=/usr/home/feer/domains/audytor.feer.org.pl/data/tajemniczy-klient.sqlite
UPLOAD_DIR=/usr/home/feer/domains/audytor.feer.org.pl/data/uploads
MAX_UPLOAD_MB=8
# Maksymalna liczba plików w jednym zapisie formularza (domyślnie 60)
MAX_UPLOAD_FILES=60

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=8

# Logowanie przez SZO (OAuth + PKCE). Wymaga w SZO: modułu „audytor”, scope'u audytor:access
# i adresu powrotu https://audytor.feer.org.pl/auth/szo/callback w desktop_allowed_redirects (patrz deploy/szo-patch.diff).
SZO_AUTH_MODE=szo
SZO_BASE_URL=https://szo.feer.org.pl
SZO_SCOPE=audytor:access
# Adresy e-mail zawsze będące administratorami (rozdzielone przecinkami); pozostałe role nadaje administrator w aplikacji
ADMIN_EMAILS=admin@example.pl
# Klucz API z SZO (Zarządzaj API) z uprawnieniami: audytor:users (import osób: panel Użytkownicy → „Importuj z SZO”)
# i audytor:mail (wysyłka powiadomień przez SZO). Bez klucza przycisk importu jest ukryty.
SZO_API_KEY=
# Rola nowej osoby logującej się pierwszy raz przez SZO (auditor lub coordinator; domyślnie auditor)
SZO_DEFAULT_ROLE=auditor

# Powiadomienia e-mail (wyłącznie czysty tekst). Zalecane: szo = wysyłka przez SZO i Microsoft Graph (nadawca systemowy SZO,
# bez własnego SMTP). Wymaga SZO_BASE_URL i SZO_API_KEY z uprawnieniami audytor:mail (i audytor:users dla importu osób).
# Pozostałe tryby: smtp (własny serwer, poniżej), log (tylko konsola), off.
MAIL_MODE=off
# Kody SMS dla użytkowników zewnętrznych: off | szo (przez SZO, uprawnienie audytor:sms) | log (tylko rozwój)
SMS_MODE=off
MAIL_FROM=
MAIL_AUTOFLUSH=true
MAIL_REMINDER_DAYS=3
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
