# ── Aplikacja ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Publiczny adres aplikacji (używany do sprawdzania Origin za reverse proxy). Opcjonalny.
APP_URL=
# true, gdy aplikacja stoi za reverse proxy (nginx, Passenger) – wtedy ciasteczka secure działają poprawnie
TRUST_PROXY=false

# ── Baza danych (SQLite) i pliki ────────────────────────────
DATABASE_PATH=./data/tajemniczy-klient.sqlite
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=8

# ── Sesja aplikacji ─────────────────────────────────────────
# Min. 32 znaki; w produkcji WYMAGANE. Wygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=8

# ── Integracja z SZO ────────────────────────────────────────
# jwt – token JWT od SZO weryfikowany lokalnie (HS256 sekret albo RS/ES klucz publiczny)
# api – token weryfikowany zapytaniem do endpointu SZO (SZO_VERIFY_URL)
# dev – tylko lokalnie: logowanie testowe bez SZO (ZABLOKOWANE przy NODE_ENV=production)
SZO_AUTH_MODE=dev

# Adres logowania w SZO; po zalogowaniu SZO przekierowuje na  {adres aplikacji}/auth/callback?token=<JWT>
# (albo wysyła POST z polem „token”).
SZO_LOGIN_URL=

# tryb jwt: wspólny sekret (HS256) LUB klucz publiczny PEM (nowe linie zapisz jako \n)
SZO_JWT_SECRET=
SZO_JWT_PUBLIC_KEY=
SZO_JWT_ALGORITHMS=HS256
SZO_JWT_ISSUER=
SZO_JWT_AUDIENCE=

# tryb api: endpoint zwracający dane użytkownika dla tokena (Authorization: Bearer …)
SZO_VERIFY_URL=
SZO_API_KEY=
SZO_TIMEOUT_MS=5000

# Nazwy pól (claimów) z danymi użytkownika w tokenie / odpowiedzi SZO
SZO_CLAIM_ID=sub
SZO_CLAIM_NAME=name
SZO_CLAIM_EMAIL=email
SZO_CLAIM_ROLE=role
# Mapowanie ról SZO → role aplikacji (administrator | coordinator | auditor), JSON w jednej linii
SZO_ROLE_MAP={"szo_admin":"administrator","szo_koordynator":"coordinator","szo_audytor":"auditor"}
# Rola nowego użytkownika, gdy SZO nie przekazuje rozpoznanej roli
SZO_DEFAULT_ROLE=auditor

# ── Powiadomienia e-mail (wyłącznie czysty tekst) ───────────
# off – brak powiadomień | log – wypisywanie w konsoli (rozwój) | smtp – prawdziwa wysyłka
MAIL_MODE=off
# Nadawca, np. Tajemniczy Klient <audytor@feer.org.pl> (wymagany w trybie smtp)
MAIL_FROM=
# true = wysyłka od razu po zdarzeniu; false = tylko cron (npm run notify)
MAIL_AUTOFLUSH=true
# Na ile dni przed terminem audytu wysłać przypomnienie
MAIL_REMINDER_DAYS=3
SMTP_HOST=
SMTP_PORT=587
# true dla portu 465 (TLS od początku); false dla 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Przy włączonych powiadomieniach wymagane jest APP_URL (adres w odnośnikach).
