<%- include('../partials/header') %>
<div class="page-head">
  <h1>Raport: dostępność kształcenia</h1>
  <a class="btn btn-secondary" href="/office/report.csv">Pobierz CSV</a>
</div>
<p class="muted">Wyniki ze <strong>zatwierdzonych</strong> ocen kandydatów (liczba ocen: <%= report.totalReviews %>). Raport jest niezależny od wyników audytów obiektów.</p>

<% if (!report.universities.length) { %><p>Brak zatwierdzonych ocen.</p><% } %>
<% for (const u of report.universities) { %>
  <section aria-labelledby="u-<%= u.objectId %>">
    <h2 id="u-<%= u.objectId %>"><%= u.name %></h2>
    <div class="score-row">
      <div class="label"><span>Wynik dostępności kształcenia (<%= u.count %> <%= u.count === 1 ? 'ocena' : 'ocen' %>)</span><span><%= fmtPct(u.score.percent) %></span></div>
      <meter min="0" max="100" value="<%= u.score.percent || 0 %>" aria-label="<%= u.name %>: <%= fmtPct(u.score.percent) %>"><%= fmtPct(u.score.percent) %></meter>
      <% if (u.score.rating) { %><div class="muted"><%= u.score.rating.label %></div><% } %>
    </div>

    <div class="table-wrap"><table>
      <caption>Wyniki według kategorii pytań</caption>
      <thead><tr><th scope="col">Kategoria</th><th scope="col" class="num">Wynik</th></tr></thead>
      <tbody><% for (const c of u.categories) { %><tr><th scope="row"><%= c.category %></th><td class="num"><%= fmtPct(c.percent) %></td></tr><% } %></tbody>
    </table></div>

    <div class="table-wrap"><table>
      <caption>Kierunki</caption>
      <thead><tr><th scope="col">Kierunek</th><th scope="col" class="num">Liczba ocen</th><th scope="col" class="num">Wynik</th><th scope="col">Oceny (kandydat, niepełnosprawność)</th></tr></thead>
      <tbody>
      <% for (const p of u.programmes) { %>
        <tr>
          <th scope="row"><%= p.name %></th>
          <td class="num"><%= p.count %></td>
          <td class="num"><%= fmtPct(p.score.percent) %></td>
          <td><% p.reviews.forEach((r, i) => { %><%= i ? '; ' : '' %><a href="/office/<%= r.id %>"><%= r.auditor %></a> (<%= disabilities[r.disability].replace('Niepełnosprawność ', '') %>, <%= fmtPct(r.percent) %>)<% }) %></td>
        </tr>
      <% } %>
      </tbody>
    </table></div>
  </section>
<% } %>
<%- include('../partials/footer') %>
