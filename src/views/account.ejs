<%- include('partials/header') %>
<h1>Moje konto</h1>
<dl class="audit-meta">
  <div><dt>Imię i nazwisko</dt><dd><%= user.name %></dd></div>
  <div><dt>E-mail</dt><dd><%= user.email || 'brak (konto z SZO bez adresu e-mail)' %></dd></div>
  <div><dt>Rola</dt><dd><%= roleLabels[user.role] %></dd></div>
</dl>

<h2>Powiadomienia e-mail</h2>
<% if (!mailEnabled) { %>
  <p class="note-box">Wysyłka powiadomień jest w tej instalacji wyłączona.</p>
<% } else if (!user.email) { %>
  <p class="note-box">Nie mamy Twojego adresu e-mail, więc powiadomienia nie mogą zostać wysłane.</p>
<% } %>
<form method="post" action="/account">
  <p>Wiadomości są wysyłane wyłącznie czystym tekstem: o przydzieleniu audytu lub oceny, złożeniu do weryfikacji, zatwierdzeniu lub zwrocie oraz o zbliżającym się terminie.</p>
  <div class="field check"><input type="checkbox" id="notifyEmail" name="notifyEmail"<% if (user.notify_email) { %> checked<% } %>><label for="notifyEmail">Wysyłaj mi powiadomienia e-mail</label></div>
  <button type="submit">Zapisz</button>
</form>
<%- include('partials/footer') %>
