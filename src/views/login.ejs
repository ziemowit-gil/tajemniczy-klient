<%- include('partials/header') %>
<%- include('partials/login-top', { title: 'Logowanie', asHeading: true }) %>
<div class="login-hero">
<div class="login-box login-card">
  <% if (authError) { %><div class="error-summary" role="alert"><%= authError %></div><% } %>
  <% if (locals.externalError) { %><div class="error-summary" role="alert" id="login-error"><%= externalError %></div><% } %>

  <% if (mode === 'dev') { %>
    <p class="note-box">Tryb deweloperski: logowanie testowe bez SZO. W produkcji jest niedostępne.</p>
    <% const demoUsers = locals.demoUsers || []; if (demoUsers.length) { %>
      <h2>Konta demonstracyjne</h2>
      <ul class="demo-users">
        <% for (const u of demoUsers) { %>
          <li>
            <form method="post" action="/auth/dev">
              <input type="hidden" name="name" value="<%= u.name %>">
              <input type="hidden" name="email" value="<%= u.email %>">
              <input type="hidden" name="role" value="<%= u.role %>">
              <button type="submit" class="btn-secondary">Zaloguj jako <%= u.name %> <span class="muted">(<%= roleLabels[u.role] %>)</span></button>
            </form>
          </li>
        <% } %>
      </ul>
      <h2>Własne konto testowe</h2>
    <% } %>
    <form method="post" action="/auth/dev" novalidate>
      <div class="field">
        <label for="name">Imię i nazwisko</label>
        <input type="text" id="name" name="name" value="<%= values.name || '' %>" required autocomplete="name"<% if (errors.name) { %> aria-invalid="true" aria-describedby="name-err"<% } %>>
        <% if (errors.name) { %><p class="field-error" id="name-err"><%= errors.name %></p><% } %>
      </div>
      <div class="field">
        <label for="email">E-mail (opcjonalnie)</label>
        <input type="email" id="email" name="email" value="<%= values.email || '' %>" autocomplete="email">
      </div>
      <div class="field">
        <label for="role">Rola</label>
        <select id="role" name="role" required<% if (errors.role) { %> aria-invalid="true" aria-describedby="role-err"<% } %>>
          <% for (const [value, label] of Object.entries(roleLabels)) { %>
            <option value="<%= value %>"<% if (values.role === value) { %> selected<% } %>><%= label %></option>
          <% } %>
        </select>
        <% if (errors.role) { %><p class="field-error" id="role-err"><%= errors.role %></p><% } %>
      </div>
      <button type="submit">Zaloguj (test)</button>
    </form>
  <% } else {
       const szoHref = mode === 'szo' ? '/auth/szo/start' : (loginUrl || null);
       const ext = Boolean(locals.externalEnabled); %>
    <% if (ext) { %>
    <form method="post" action="/login/external" novalidate class="ext-form" aria-label="Logowanie kontem zewnętrznym">
      <div class="field"><label for="ext-email">E-mail:</label><input type="email" id="ext-email" name="email" value="<%= values.email || '' %>" autocomplete="username" required autofocus<% if (locals.externalError) { %> aria-invalid="true" aria-describedby="login-error"<% } %>></div>
      <div class="field"><label for="ext-password">Hasło:</label><input type="password" id="ext-password" name="password" autocomplete="current-password" required></div>
      <div class="login-buttons">
        <button type="submit">Zaloguj</button>
        <button type="reset">Wyczyść</button>
        <a href="#nie-pamietam">Nie pamiętam hasła</a>
      </div>
      <p class="small">Po podaniu hasła wyślemy kod SMS na numer zapisany w Twoim koncie.</p>
    </form>
    <hr class="login-sep">
    <% } %>
    <% if (szoHref) { %>
    <h2 id="alt-h"><%= ext ? 'Lub zaloguj przez:' : 'Zaloguj się przez:' %></h2>
    <a class="btn btn-outline" href="<%= szoHref %>" aria-describedby="alt-note">Panel Współpracownika</a>
    <p class="small" id="alt-note">Zalogujesz się kontem Microsoft 365 w Panelu Współpracownika i potwierdzisz dostęp aplikacji.</p>
    <% } else { %>
    <p class="muted">Adres logowania Panelu Współpracownika nie jest skonfigurowany (SZO_LOGIN_URL). Skontaktuj się z administratorem.</p>
    <% } %>
    <% if (ext) { %><p class="small">Nie masz konta zewnętrznego? <a href="/register">Załóż konto kodem rejestracyjnym</a></p><% } %>
  <% } %>
</div>
<%- include('partials/login-info') %>
</div>
<%- include('partials/footer') %>
