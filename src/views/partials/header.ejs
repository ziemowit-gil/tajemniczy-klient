<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> – Tajemniczy Klient</title>
  <link rel="icon" type="image/svg+xml" href="<%= asset('img/icon.svg') %>">
  <link rel="stylesheet" href="<%= asset('css/app.css') %>">
  <script src="<%= asset('js/app.js') %>" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Przejdź do treści</a>
<header class="site-header">
  <div class="inner">
    <a class="brand" href="/"><svg class="logo-mark" viewBox="0 0 64 64" width="30" height="30" aria-hidden="true" focusable="false"><circle cx="27" cy="27" r="19" fill="none" stroke="currentColor" stroke-width="5"/><circle cx="27" cy="21" r="6" fill="currentColor"/><path d="M15.5 38.5c1.6-6.2 6.4-9.5 11.5-9.5s9.9 3.3 11.5 9.5" fill="currentColor"/><path d="M41 41l15 15" stroke="#ea8f00" stroke-width="7" stroke-linecap="round"/></svg><span>Tajemniczy Klient</span></a>
    <% if (currentUser) {
         const groups = menuFor(currentUser.role);
         const best = currentHref(groups, currentPath);
         const multi = currentUser.roles && currentUser.roles.length > 1;
    %>
    <div class="user-box">
      <a href="/account" class="account-link"<% if (currentPath === '/account') { %> aria-current="page"<% } %>><%- include('icon', { name: 'account', size: 18 }) %><span><%= currentUser.name %></span><% if (!multi) { %><span class="sr-only"> (<%= roleLabels[currentUser.role] %>)</span><% } %></a>
      <% if (multi) { %>
        <form method="post" action="/role" class="role-switch">
          <label for="role-switch" class="sr-only">Aktywna rola</label>
          <select id="role-switch" name="role">
            <% for (const r of currentUser.roles) { %><option value="<%= r %>"<% if (r === currentUser.role) { %> selected<% } %>><%= roleLabels[r] %></option><% } %>
          </select>
          <button type="submit" class="btn-small">Przełącz</button>
        </form>
      <% } %>
      <% if (!locals.hideNav) { %>
      <nav aria-label="Główna">
        <details class="main-menu">
          <summary class="menu-btn">Menu</summary>
          <div class="menu-panel">
            <% for (const g of groups) { %>
              <section class="menu-group" aria-labelledby="menu-<%= g.id %>">
                <h2 id="menu-<%= g.id %>"><%= g.title %></h2>
                <ul>
                  <% for (const l of g.links) { %>
                    <li><a href="<%= l.href %>"<% if (best === l.href) { %> aria-current="page"<% } %>><%- include('icon', { name: l.icon, size: 20 }) %><span><%= l.label %></span></a></li>
                  <% } %>
                </ul>
              </section>
            <% } %>
            <div class="menu-foot">
              <form method="post" action="/logout"><button type="submit" class="link-button">Wyloguj się</button></form>
            </div>
          </div>
        </details>
      </nav>
      <% } else { %>
      <form method="post" action="/logout"><button type="submit" class="link-button">Wyloguj</button></form>
      <% } %>
    </div>
    <% } %>
  </div>
</header>
<main id="main" tabindex="-1">
<% if (flash) { %>
  <div class="flash flash-<%= flash.type === 'error' ? 'error' : flash.type === 'success' ? 'success' : 'info' %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>"><%= flash.message %></div>
<% } %>
