<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> – Tajemniczy Klient</title>
  <link rel="icon" type="image/svg+xml" href="<%= asset('img/icon.svg') %>">
  <link rel="stylesheet" href="<%= asset('css/app.css') %>">
  <script src="<%= asset('js/app.js') %>" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Przejdź do treści</a>
<header class="site-header">
  <div class="inner">
    <a class="brand" href="/">Tajemniczy Klient</a>
    <% if (currentUser) {
         const role = currentUser.role;
         // Praca na co dzień (główne menu) oraz zarządzanie słownikami (grupa „Administracja”, tylko administrator).
         const links = [['/', 'Pulpit']];
         links.push(['/audits', role === 'auditor' ? 'Moje audyty' : 'Audyty']);
         links.push(['/office', 'Dostępność kształcenia']);
         if (role === 'administrator' || role === 'coordinator') { links.push(['/objects', 'Obiekty']); links.push(['/reports', 'Raporty']); links.push(['/stats', 'Statystyki']); }
         const adminLinks = role === 'administrator'
           ? [['/criteria', 'Kryteria audytu'], ['/scenarios', 'Scenariusze'], ['/office/questions', 'Pytania: kształcenie'], ['/users', 'Użytkownicy'], ['/settings/szo', 'Integracja z SZO']]
           : [];
         const all = links.concat(adminLinks);
         const best = all.filter(([h]) => h === '/' ? currentPath === '/' : (currentPath === h || currentPath.startsWith(h + '/'))).sort((a, b) => b[0].length - a[0].length)[0];
         const adminCurrent = Boolean(best && adminLinks.some(([h]) => h === best[0]));
    %>
    <% if (!locals.hideNav) { %>
    <nav aria-label="Główna">
      <ul>
        <% for (const [href, label] of links) { const here = best && best[0] === href; %>
          <li><a href="<%= href %>"<% if (here) { %> aria-current="page"<% } %>><%= label %></a></li>
        <% } %>
        <% if (adminLinks.length) { %>
          <li class="nav-group-item">
            <details class="nav-group<%= adminCurrent ? ' is-current' : '' %>">
              <summary>Administracja<% if (adminCurrent) { %><span class="sr-only"> (bieżąca sekcja)</span><% } %></summary>
              <ul>
                <% for (const [href, label] of adminLinks) { const here = best && best[0] === href; %>
                  <li><a href="<%= href %>"<% if (here) { %> aria-current="page"<% } %>><%= label %></a></li>
                <% } %>
              </ul>
            </details>
          </li>
        <% } %>
      </ul>
    </nav>
    <% } %>
    <div class="user-box">
      <a href="/account" class="account-link"<% if (currentPath === '/account') { %> aria-current="page"<% } %>><%= currentUser.name %> (<%= roleLabels[currentUser.role] %>)</a>
      <% if (currentUser.roles && currentUser.roles.length > 1) { %>
        <form method="post" action="/role" class="role-switch">
          <label for="role-switch">Aktywna rola</label>
          <select id="role-switch" name="role">
            <% for (const r of currentUser.roles) { %><option value="<%= r %>"<% if (r === currentUser.role) { %> selected<% } %>><%= roleLabels[r] %></option><% } %>
          </select>
          <button type="submit" class="btn-small">Przełącz</button>
        </form>
      <% } %>
      <form method="post" action="/logout"><button type="submit" class="link-button">Wyloguj</button></form>
    </div>
    <% } %>
  </div>
</header>
<main id="main" tabindex="-1">
<% if (flash) { %>
  <div class="flash flash-<%= flash.type === 'error' ? 'error' : flash.type === 'success' ? 'success' : 'info' %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>"><%= flash.message %></div>
<% } %>
