<%#
  Pole formularza z etykietą, podpowiedzią i komunikatem błędu (powiązanymi przez aria-describedby).
  Parametry: name, label, kind ('input'|'textarea'|'select'), type, value, errors, hint, required, options [[value,label]], blank, extraAttrs (stałe atrybuty HTML, np. data-*)
%>
<% const hint = locals.hint, required = locals.required, blank = locals.blank, type = locals.type || 'text', value = locals.value;
   const err = locals.errors && locals.errors[name];
   const describedby = [hint ? `${name}-hint` : '', err ? `${name}-err` : ''].filter(Boolean).join(' ');
   const attrs = `id="${name}" name="${name}"${required ? ' required' : ''}${err ? ' aria-invalid="true"' : ''}${describedby ? ` aria-describedby="${describedby}"` : ''}${locals.extraAttrs ? ` ${locals.extraAttrs}` : ''}`; %>
<div class="field">
  <label for="<%= name %>"><%= label %><% if (required) { %> <span class="muted">(wymagane)</span><% } %></label>
  <% if (hint) { %><p class="hint" id="<%= name %>-hint"><%= hint %></p><% } %>
  <% if (kind === 'textarea') { %>
    <textarea <%- attrs %>><%= value ?? '' %></textarea>
  <% } else if (kind === 'select') { %>
    <select <%- attrs %>>
      <% if (blank !== undefined && blank !== null) { %><option value=""><%= blank %></option><% } %>
      <% for (const [v, l] of locals.options) { %><option value="<%= v %>"<% if (String(value ?? '') === String(v)) { %> selected<% } %>><%= l %></option><% } %>
    </select>
  <% } else { %>
    <input type="<%= type %>" <%- attrs %> value="<%= value ?? '' %>">
  <% } %>
  <% if (err) { %><p class="field-error" id="<%= name %>-err"><%= err %></p><% } %>
</div>
