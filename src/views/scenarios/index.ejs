<%- include('../partials/header') %>
<div class="page-head"><h1>Scenariusze „Tajemniczego Klienta”</h1><a class="btn" href="/scenarios/new">Dodaj scenariusz</a></div>

<form method="get" action="/scenarios" class="actions filter-form">
  <div class="field-inline">
    <label for="f-usage">Dotyczy</label>
    <select id="f-usage" name="usage">
      <option value="">Wszystkie moduły</option>
      <% for (const [v, l] of Object.entries(usageLabels)) { %><option value="<%= v %>"<% if (filter.usage === v) { %> selected<% } %>><%= l %></option><% } %>
    </select>
  </div>
  <div class="field-inline">
    <label for="f-active">Aktywność</label>
    <select id="f-active" name="active">
      <option value="">Wszystkie</option>
      <option value="1"<% if (filter.active === '1') { %> selected<% } %>>Aktywne</option>
      <option value="0"<% if (filter.active === '0') { %> selected<% } %>>Nieaktywne</option>
    </select>
  </div>
  <button type="submit" class="btn-secondary">Filtruj</button>
  <% if (filter.usage || filter.active) { %><a href="/scenarios">Wyczyść filtry</a><% } %>
</form>
<p role="status" class="muted">Liczba scenariuszy: <%= scenarios.length %>.</p>

<% if (!scenarios.length) { %><p>Brak scenariuszy spełniających kryteria.</p><% } else { %>
<div class="table-wrap"><table>
  <caption class="sr-only">Lista scenariuszy</caption>
  <thead><tr><th scope="col">Tytuł</th><th scope="col">Dotyczy</th><th scope="col">Persona</th><th scope="col" class="num">Kroki</th><th scope="col" class="num">Wersja</th><th scope="col" class="num">Użyć</th><th scope="col">Aktywny</th><th scope="col">Akcje</th></tr></thead>
  <tbody>
  <% for (const s of scenarios) { %>
    <tr>
      <th scope="row"><a href="/scenarios/<%= s.id %>"><%= s.title %></a></th>
      <td><%= usageLabels[s.usage] %></td>
      <td><%= s.persona ? personaLabels[s.persona].replace('Niepełnosprawność ', '') : '—' %></td>
      <td class="num"><%= s.step_count %></td>
      <td class="num"><%= s.version %></td>
      <td class="num"><%= s.use_count %></td>
      <td><%= s.active ? 'Tak' : 'Nie' %></td>
      <td class="actions">
        <a href="/scenarios/<%= s.id %>/edit">Edytuj<span class="sr-only">: <%= s.title %></span></a>
        <form method="post" action="/scenarios/<%= s.id %>/duplicate"><button type="submit" class="btn btn-secondary btn-small">Duplikuj<span class="sr-only">: <%= s.title %></span></button></form>
        <form method="post" action="/scenarios/<%= s.id %>/delete" data-confirm="Usunąć scenariusz „<%= s.title %>”?">
          <button type="submit" class="btn btn-danger btn-small">Usuń<span class="sr-only">: <%= s.title %></span></button>
        </form>
      </td>
    </tr>
  <% } %>
  </tbody>
</table></div>
<% } %>
<%- include('../partials/footer') %>
