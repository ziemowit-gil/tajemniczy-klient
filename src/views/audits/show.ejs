<%- include('../partials/header') %>
<div class="page-head">
  <h1><%= audit.object_name %></h1>
  <div class="actions">
    <% if (canExport) { %>
      <a class="btn btn-secondary" href="/audits/<%= audit.id %>/report.pdf">Pobierz PDF</a>
      <a class="btn btn-secondary" href="/audits/<%= audit.id %>/report.csv">Pobierz CSV</a>
    <% } %>
    <% if (canManage && canAssign) { %>
      <form method="post" action="/audits/<%= audit.id %>/delete" data-confirm="Usunąć ten audyt?"><button type="submit" class="btn btn-danger">Usuń audyt</button></form>
    <% } %>
  </div>
</div>

<dl class="audit-meta">
  <div><dt>Status</dt><dd><span class="status status-<%= audit.status %>"><%= statusLabels[audit.status] %></span></dd></div>
  <div><dt>Scenariusze</dt><dd><%= scenarios.map((s) => s.title).join('; ') %></dd></div>
  <div><dt>Audytor / Tajemniczy Klient</dt><dd><%= audit.auditor_name || 'Nieprzydzielony' %></dd></div>
  <% if (audit.entered_by_name) { %><div><dt>Wprowadził(-a)</dt><dd><%= audit.entered_by_name %>, <%= fmtDateTime(audit.created_at) %></dd></div><% } %>
  <% if (audit.assigned_at) { %><div><dt>Przydzielono</dt><dd><%= fmtDateTime(audit.assigned_at) %></dd></div><% } %>
  <div><dt>Termin</dt><dd><%= audit.due_date ? fmtDate(audit.due_date) : '—' %></dd></div>
  <% if (audit.submitted_at) { %><div><dt>Złożono</dt><dd><%= fmtDateTime(audit.submitted_at) %></dd></div><% } %>
  <% if (audit.approved_at) { %><div><dt>Zatwierdzono</dt><dd><%= fmtDateTime(audit.approved_at) %><%= audit.reviewer_name ? `, ${audit.reviewer_name}` : '' %></dd></div><% } %>
</dl>

<% if (canAccept) { %>
<section class="accept-box" aria-labelledby="accept-h">
  <h2 id="accept-h">Audyt czeka na przyjęcie</h2>
  <p>Przydzielono Ci ten audyt<%= audit.due_date ? ` z terminem ${fmtDate(audit.due_date)}` : '' %>. Przyjmij go, gdy możesz go wykonać; status zmieni się na „W trakcie”, a koordynator zobaczy to w historii.</p>
  <form method="post" action="/audits/<%= audit.id %>/accept"><button type="submit">Przyjmij audyt</button></form>
</section>
<% } %>

<%- include('../partials/scenario-steps', { scenarios, editable: canEdit, formId: 'audit-form', personaLabels: disabilityLabels }) %>

<% if (audit.review_comment && audit.status !== 'submitted') { %>
  <div class="note-box"><strong>Komentarz koordynatora:</strong> <%= audit.review_comment %></div>
<% } %>
<% if (errors._form) { %><div class="error-summary" role="alert"><%= errors._form %></div><% } %>

<% if (canAssign) { %>
<section aria-labelledby="assign-h">
  <h2 id="assign-h"><%= audit.auditor_id ? 'Zmień Tajemniczego Klienta' : 'Przydziel Tajemniczego Klienta' %></h2>
  <form method="post" action="/audits/<%= audit.id %>/assign">
    <div class="field">
      <label for="assign-auditor">Audytor / Tajemniczy Klient</label>
      <select id="assign-auditor" name="auditorId" required>
        <option value="">— wybierz —</option>
        <% for (const a of auditors) { %><option value="<%= a.id %>"<% if (a.id === audit.auditor_id) { %> selected<% } %>><%= a.name %></option><% } %>
      </select>
    </div>
    <button type="submit"><%= audit.auditor_id ? 'Zmień przydział' : 'Przydziel do TK' %></button>
  </form>
</section>
<% } %>

<section aria-labelledby="summary-h">
  <h2 id="summary-h">Wstępne podsumowanie</h2>
  <% for (const line of summary.lines) { %><p><%= line %></p><% } %>
  <%- include('../partials/scores', { score: summary.score }) %>
</section>

<% if (canReview) { %>
<section aria-labelledby="review-h">
  <h2 id="review-h">Weryfikacja koordynatora</h2>
  <form method="post" action="/audits/<%= audit.id %>/approve">
    <div class="field">
      <label for="review-comment">Komentarz (wymagany przy zwrocie do poprawy)</label>
      <textarea id="review-comment" name="comment"></textarea>
    </div>
    <div class="actions">
      <button type="submit">Zatwierdź audyt</button>
      <button type="submit" class="btn-secondary" formaction="/audits/<%= audit.id %>/return">Zwróć do poprawy</button>
    </div>
  </form>
</section>
<% } %>

<h2>Formularz oceny</h2>
<% if (canEdit) { %>
<form id="audit-form" method="post" action="/audits/<%= audit.id %>" enctype="multipart/form-data" novalidate>
<% } %>

<% for (const g of groups) { %>
  <section aria-labelledby="area-<%= g.area %>">
    <h3 id="area-<%= g.area %>"><%= g.label %></h3>
    <% for (const cat of g.categories) { %>
      <h4><%= cat.name %></h4>
      <% for (const item of cat.items) { const problem = problems[item.id]; %>
        <fieldset class="criterion<%= problem ? ' has-problem' : '' %>"<% if (problem) { %> aria-describedby="problem-<%= item.id %>"<% } %>>
          <legend><span class="code"><%= item.code %> · waga <%= item.weight %></span><br><%= item.text %></legend>
          <% if (item.hint) { %><p class="hint"><%= item.hint %></p><% } %>
          <% if (problem) { %><p class="field-error" id="problem-<%= item.id %>"><%= problem %></p><% } %>

          <% if (canEdit) { %>
            <div class="options">
              <% for (const opt of answerOptions[item.answer_type].concat([{ value: 'nd', label: 'Nie dotyczy' }])) { %>
                <div class="check">
                  <input type="radio" id="a-<%= item.id %>-<%= opt.value %>" name="answer_<%= item.id %>" value="<%= opt.value %>"<% if (item.answer === opt.value) { %> checked<% } %>>
                  <label for="a-<%= item.id %>-<%= opt.value %>"><%= opt.label %></label>
                </div>
              <% } %>
            </div>
            <div class="field field-wide">
              <label for="c-<%= item.id %>">Komentarz<% if (item.answer === 'nd') { %> (wymagane uzasadnienie)<% } %></label>
              <textarea id="c-<%= item.id %>" name="comment_<%= item.id %>"><%= item.comment || '' %></textarea>
            </div>
            <div class="field field-wide">
              <label for="f-<%= item.id %>">Dodaj zdjęcie lub plik (JPEG, PNG, WebP, PDF)</label>
              <input type="file" id="f-<%= item.id %>" name="files_<%= item.id %>" accept="image/jpeg,image/png,image/webp,application/pdf" multiple>
            </div>
          <% } else { %>
            <p><strong>Odpowiedź:</strong> <%= answerLabel({ answer: item.answer, answerType: item.answer_type }) %></p>
            <% if (item.comment) { %><p><strong>Komentarz:</strong> <%= item.comment %></p><% } %>
          <% } %>

          <%- include('../partials/attachment-list', { files: item.files, base: `/audits/${audit.id}`, code: item.code, canEdit }) %>
        </fieldset>
      <% } %>
    <% } %>
  </section>
<% } %>

<% if (canEdit) { %>
  <div class="field field-wide">
    <label for="generalNotes">Uwagi ogólne</label>
    <textarea id="generalNotes" name="generalNotes"><%= audit.general_notes || '' %></textarea>
  </div>
  <div class="actions">
    <button type="submit" name="intent" value="save" class="btn-secondary">Zapisz</button>
    <button type="submit" name="intent" value="submit" data-confirm="Po złożeniu audytu nie będzie można go edytować. Złożyć audyt?">Zapisz i złóż audyt</button>
  </div>
</form>
  <% for (const g of groups) for (const cat of g.categories) for (const item of cat.items) for (const f of item.files) { %>
    <form id="del-<%= f.id %>" method="post" action="/audits/<%= audit.id %>/attachments/<%= f.id %>/delete"></form>
  <% } %>
<% } else if (audit.general_notes) { %>
  <h3>Uwagi ogólne</h3><p><%= audit.general_notes %></p>
<% } %>
<%- include('../partials/history', { history, historyLabels }) %>
<%- include('../partials/footer') %>
