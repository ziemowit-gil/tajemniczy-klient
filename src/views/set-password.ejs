<%- include('partials/header') %>
<div class="login-hero">
<div class="login-box login-card">
  <h1>Ustaw hasło</h1>
  <% if (!valid) { %>
    <div class="error-summary" role="alert"><%= error || 'Link wygasł albo został już użyty. Poproś administratora o nowy.' %></div>
    <p><a href="/login">Przejdź do logowania</a></p>
  <% } else { %>
    <p>Konto: <strong><%= person.name %></strong> (<%= person.email %>). Ustaw hasło, którego będziesz używać razem z kodem SMS.</p>
    <% if (error) { %><div class="error-summary" role="alert"><%= error %></div><% } %>
    <form method="post" action="/ext/set-password" novalidate>
      <input type="hidden" name="token" value="<%= token %>">
      <div class="field">
        <label for="password">Nowe hasło</label>
        <p class="hint" id="pw-hint">Co najmniej 12 znaków. Może to być fraza z kilku słów. Bez swojego e-maila, imienia i nazwiska.</p>
        <input type="password" id="password" name="password" autocomplete="new-password" minlength="12" required aria-describedby="pw-hint">
      </div>
      <div class="field">
        <label for="password2">Powtórz hasło</label>
        <input type="password" id="password2" name="password2" autocomplete="new-password" minlength="12" required>
      </div>
      <button type="submit">Ustaw hasło</button>
    </form>
  <% } %>
</div>
</div>
<%- include('partials/footer') %>
