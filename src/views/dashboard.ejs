<%- include('partials/header') %>
<div class="page-head">
  <div>
    <h1>Pulpit</h1>
    <p class="lead">Witaj, <%= currentUser.name %>. <%= todo.length ? `Masz ${todo.length} ${todo.length === 1 ? 'pozycję' : 'pozycji'} wymagających uwagi.` : 'Nic nie czeka na Twoje działanie.' %></p>
  </div>
  <div class="actions">
    <% if (currentUser.role === 'administrator' || currentUser.role === 'coordinator') { %><a class="btn" href="/audits/new">Wprowadź audyt</a><% } %>
    <% if (currentUser.role === 'auditor' || currentUser.role === 'administrator') { %><a class="btn btn-secondary" href="/office/new">Nowa ocena kształcenia</a><% } %>
  </div>
</div>

<h2><%= todoHeading %></h2>
<% if (!todo.length) { %>
  <p class="empty">Brak pozycji. Gdy pojawi się coś do zrobienia, zobaczysz to tutaj.</p>
<% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th scope="col">Obiekt</th><th scope="col">Rodzaj</th><th scope="col">Zakres</th><th scope="col">Audytor</th><th scope="col">Status</th><th scope="col">Termin</th></tr></thead>
    <tbody>
    <% for (const a of todo) { %>
      <tr>
        <th scope="row"><a href="<%= a.href %>"><%= a.title %></a></th>
        <td><%= a.kindLabel %></td><td><%= a.detail || '—' %></td><td><%= a.auditor_name || 'Nieprzydzielony' %></td>
        <td><span class="status status-<%= a.status %>"><%= statusLabels[a.status] %></span></td>
        <td><%= a.due_date ? fmtDate(a.due_date) : '—' %></td>
      </tr>
    <% } %>
    </tbody>
  </table></div>
<% } %>

<h2>Wszystkie pozycje według statusu</h2>
<div class="cards">
  <% for (const [status, label] of Object.entries(statusLabels)) { %>
    <a class="card" href="/audits?status=<%= status %>">
      <span class="big"><%= counts[status] %></span><%= label %>
    </a>
  <% } %>
</div>
<%- include('partials/footer') %>
